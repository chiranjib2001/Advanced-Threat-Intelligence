# ==============================================================================
# Automated Threat Intelligence (ATI V2) - Environment Variables Template
# Copy this file to .env and populate with your own API keys.
# DO NOT commit .env with real credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Inference Providers (Zero-Cost / Cascading Pool)
# Supports multiple comma-separated keys for rate-limit cooldown cycling.
# ------------------------------------------------------------------------------
# GroqCloud API Key(s) (Ultra-fast LPU inference: Llama 3.3, Qwen 2.5, DeepSeek)
GROQ_API_KEYS=

# Cerebras Cloud API Key(s) (High-speed inference)
CEREBRAS_API_KEYS=

# OpenRouter API Key(s) (Free-tier model cascade: deepseek/deepseek-chat:free, etc.)
OPENROUTER_API_KEY=

# Google Gemini API Key(s) (Google AI Studio)
GEMINI_API_KEYS=

# Mistral AI API Key(s) (Codestral / Mistral Large)
MISTRAL_API_KEYS=

# Local Ollama Base URL (Offline fallback inference)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 2. Exploit Intelligence & Data Sources (Optional but Recommended)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (Increases GitHub Search API limit from 10 to 30 req/min)
GITHUB_TOKEN=

# NIST NVD API Key (Increases NIST rate limit from 5 req/30s to 50 req/30s)
NIST_API_KEY=

# ------------------------------------------------------------------------------
# 3. Notification Webhook (Optional)
# ------------------------------------------------------------------------------
# Slack, Microsoft Teams, or Discord incoming webhook URL for real-time threat alerts
WEBHOOK_URL=
